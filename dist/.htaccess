<IfModule mod_rewrite.c>
  RewriteEngine On
  Options -MultiViews

  # Direct access to actual files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all SPA history routes to index.php
  RewriteRule ^ index.php [L,QSA]
</IfModule>
